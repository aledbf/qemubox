#!/usr/bin/env bash

#
# Create release tarball with proper directory structure
#
set -eu -o pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUTPUT_DIR="${ROOT_DIR}/_output"

cd "${ROOT_DIR}"

# download fetches a URL to a destination path robustly.
# - Forces HTTP/1.1: GitHub's CDN intermittently aborts HTTP/2 streams with
#   "stream not closed cleanly: PROTOCOL_ERROR" (curl exit 92).
# - Retries transient failures.
# - Writes to a temp file and renames on success, so a failed attempt never
#   leaves a truncated file behind that a later run would reuse.
download() {
  local url="$1" dest="$2" tmp
  tmp="$(mktemp "${dest}.XXXXXX")"
  if ! curl -fsSL --http1.1 \
      --retry 5 --retry-delay 2 --retry-all-errors \
      --connect-timeout 30 \
      -o "${tmp}" "${url}"; then
    rm -f "${tmp}"
    echo "error: failed to download ${url}" >&2
    return 1
  fi
  mv -f "${tmp}" "${dest}"
}

echo "Creating release tarball..."

VERSION="${VERSION:-$(git describe --tags --always --dirty 2>/dev/null || echo "dev")}"
RELEASE_NAME="spinbox-${VERSION}-linux-x86_64"
RELEASE_DIR="${OUTPUT_DIR}/release/${RELEASE_NAME}"

rm -rf "${OUTPUT_DIR}/release"
mkdir -p "${RELEASE_DIR}/usr/share/spin-stack/bin"
mkdir -p "${RELEASE_DIR}/usr/share/spin-stack/kernel"
mkdir -p "${RELEASE_DIR}/usr/share/spin-stack/config"

echo "Copying artifacts to release structure..."

artifacts=(
  "${OUTPUT_DIR}/kernel/vmlinux:kernel:vmlinux"
  "${OUTPUT_DIR}/spinbox-initrd:kernel:spinbox-initrd"
  "${OUTPUT_DIR}/containerd-shim-spinbox-v1:bin:containerd-shim-spinbox-v1"
  "${OUTPUT_DIR}/spinbox-commit:bin:spinbox-commit"
  "${OUTPUT_DIR}/vminitd:bin:vminitd"
)

for entry in "${artifacts[@]}"; do
  IFS=":" read -r src rel dest <<< "${entry}"
  if [ -f "${src}" ]; then
    cp "${src}" "${RELEASE_DIR}/usr/share/spin-stack/${rel}/${dest}"
    echo "  ok: ${dest}"
  fi
done

echo "Adding QEMU binaries and firmware..."
# QEMU and qemu-img both, and neither optional. They arrive together from one
# spin-machine release (`task machine`), so one missing means the fetch did not run
# or did not finish — and a release that installs without them is a host whose VMs
# do not start, found at run time instead of here.
#
# qemu-img is not a convenience: a container's writable layer is a qcow2 overlay
# created by running it.
for binary in qemu-system-x86_64 qemu-img; do
  if [ -f "${OUTPUT_DIR}/bin/${binary}" ]; then
    install -m 0755 "${OUTPUT_DIR}/bin/${binary}" "${RELEASE_DIR}/usr/share/spin-stack/bin/${binary}"
    echo "  ok: ${binary}"
  else
    echo "👹 Error: ${OUTPUT_DIR}/bin/${binary} not found - run: task machine"
    exit 1
  fi
done

if [ -d "${OUTPUT_DIR}/qemu" ]; then
  mkdir -p "${RELEASE_DIR}/usr/share/spin-stack/qemu"
  cp -r "${OUTPUT_DIR}/qemu/"* "${RELEASE_DIR}/usr/share/spin-stack/qemu/"
  echo "  ok: QEMU firmware files"
else
  echo "  warn: QEMU firmware files not found - skipping"
fi

# The firmware a q35 started with -nodefaults -nographic and a PVH kernel needs, which is
# what a spin-machine release ships. vgabios-stdvga.bin is not on the list any more because no
# display adapter is built or created; pvh.bin is, and it was missing from this check while
# being the one file a direct kernel boot cannot start without — QEMU has no entry point
# into a PVH ELF kernel otherwise, and it fails as a rom-open error that reads like a
# backend bug.
missing_qemu_firmware=0
for firmware in bios.bin bios-256k.bin pvh.bin kvmvapic.bin efi-virtio.rom; do
  if [ ! -f "${RELEASE_DIR}/usr/share/spin-stack/qemu/${firmware}" ]; then
    echo "👹 Error: missing QEMU firmware file ${firmware} in release"
    missing_qemu_firmware=1
  fi
done

if [ "${missing_qemu_firmware}" -ne 0 ]; then
  if [ -d "${OUTPUT_DIR}/qemu" ]; then
    echo "Contents of ${OUTPUT_DIR}/qemu:"
    ls -la "${OUTPUT_DIR}/qemu" || true
  fi
  exit 1
fi

echo "Copying configuration files..."
cp -r deploy/config/* "${RELEASE_DIR}/usr/share/spin-stack/config/"
echo "  ok: config files (containerd, cni)"

echo "Copying spinbox config example..."
mkdir -p "${RELEASE_DIR}/usr/share/spin-stack/config/spinbox"
cp examples/config.json "${RELEASE_DIR}/usr/share/spin-stack/config/spinbox/config.json"
echo "  ok: spinbox config.json example"

echo "Copying systemd services..."
mkdir -p "${RELEASE_DIR}/usr/share/spin-stack/systemd"
cp deploy/systemd/*.service "${RELEASE_DIR}/usr/share/spin-stack/systemd/"
echo "  ok: systemd services"

echo "Copying install scripts..."
cp deploy/install.sh "${RELEASE_DIR}/"
cp deploy/uninstall.sh "${RELEASE_DIR}/"
chmod +x "${RELEASE_DIR}/install.sh"
chmod +x "${RELEASE_DIR}/uninstall.sh"
echo "  ok: install/uninstall scripts"

echo "Downloading nerdctl-full (includes containerd, runc, nerdctl, ctr)..."
NERDCTL_VERSION="${NERDCTL_VERSION:-2.3.2}"
NERDCTL_URL="https://github.com/containerd/nerdctl/releases/download/v${NERDCTL_VERSION}/nerdctl-full-${NERDCTL_VERSION}-linux-amd64.tar.gz"
NERDCTL_TARBALL="${OUTPUT_DIR}/nerdctl-full-${NERDCTL_VERSION}-linux-amd64.tar.gz"

if [ ! -f "${NERDCTL_TARBALL}" ]; then
  download "${NERDCTL_URL}" "${NERDCTL_TARBALL}"
fi

echo "Extracting nerdctl-full components (containerd, containerd-shim-runc-v2, nerdctl, ctr, runc)..."
tar -xzf "${NERDCTL_TARBALL}" -C "${RELEASE_DIR}/usr/share/spin-stack/" \
  bin/containerd \
  bin/containerd-shim-runc-v2 \
  bin/nerdctl \
  bin/ctr \
  bin/runc
echo "  ok: containerd, containerd-shim-runc-v2, runc, ctr, nerdctl"

mkdir -p "${RELEASE_DIR}/usr/share/spin-stack/libexec/cni"
tar -xzf "${NERDCTL_TARBALL}" -C "${RELEASE_DIR}/usr/share/spin-stack/libexec/cni" --strip-components=2 \
  libexec/cni/bandwidth \
  libexec/cni/bridge \
  libexec/cni/dhcp \
  libexec/cni/firewall \
  libexec/cni/host-device \
  libexec/cni/host-local \
  libexec/cni/loopback \
  libexec/cni/portmap \
  libexec/cni/ptp \
  libexec/cni/tuning
echo "  ok: CNI plugins"

echo "Building tc-redirect-tap CNI plugin..."
TC_REDIRECT_TAP_DIR="${OUTPUT_DIR}/tc-redirect-tap"
if [ ! -d "${TC_REDIRECT_TAP_DIR}" ]; then
  git clone --depth=1 https://github.com/awslabs/tc-redirect-tap "${TC_REDIRECT_TAP_DIR}"
fi

(cd "${TC_REDIRECT_TAP_DIR}" && \
  env GOWORK=off CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags '-extldflags "-static" -s -w' \
    -tags 'osusergo netgo static_build' \
    -o tc-redirect-tap ./cmd/tc-redirect-tap)

cp "${TC_REDIRECT_TAP_DIR}/tc-redirect-tap" \
  "${RELEASE_DIR}/usr/share/spin-stack/libexec/cni/"
chmod +x "${RELEASE_DIR}/usr/share/spin-stack/libexec/cni/tc-redirect-tap"
echo "  ok: tc-redirect-tap CNI plugin"

echo "Downloading spin-erofs-snapshotter and erofs tools..."
EROFS_SNAPSHOTTER_VERSION="${EROFS_SNAPSHOTTER_VERSION:-v20260612.04}"
EROFS_SNAPSHOTTER_BASE_URL="https://github.com/spin-stack/erofs-snapshotter/releases/download/${EROFS_SNAPSHOTTER_VERSION}"

EROFS_SNAPSHOTTER_BINARIES=(
  "spin-erofs-snapshotter-linux-amd64:spin-erofs-snapshotter"
  "dump.erofs-linux-amd64:dump.erofs"
  "fsck.erofs-linux-amd64:fsck.erofs"
  "mkfs.erofs-linux-amd64:mkfs.erofs"
)

for entry in "${EROFS_SNAPSHOTTER_BINARIES[@]}"; do
  IFS=":" read -r src dest <<< "${entry}"
  bin_path="${OUTPUT_DIR}/${src}"

  if [ ! -f "${bin_path}" ]; then
    download "${EROFS_SNAPSHOTTER_BASE_URL}/${src}" "${bin_path}"
  fi

  cp "${bin_path}" "${RELEASE_DIR}/usr/share/spin-stack/bin/${dest}"
  chmod +x "${RELEASE_DIR}/usr/share/spin-stack/bin/${dest}"
  echo "  ok: ${dest}"
done

echo "Creating tarball..."
cd "${OUTPUT_DIR}/release"
tar czf "${RELEASE_NAME}.tar.gz" "${RELEASE_NAME}"
cd "${ROOT_DIR}"

echo "Release created: ${OUTPUT_DIR}/release/${RELEASE_NAME}.tar.gz"
echo ""
echo "Installation:"
echo "  tar xzf ${RELEASE_NAME}.tar.gz"
echo "  cd ${RELEASE_NAME}"
echo "  sudo ./install.sh"
echo ""
echo "Uninstallation:"
echo "  sudo ./uninstall.sh"
